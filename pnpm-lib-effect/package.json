{
  "name": "effect-library-workspace",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@effect/tsgo": "0.59.0",
    "@oxlint/plugins": "1.80.0",
    "oxfmt": "^0.65.0",
    "oxlint": "1.80.0"
  },
  "packageManager": "pnpm@11.13.1"
}
