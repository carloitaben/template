{
  "name": "effect-library-workspace",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@effect/tsgo": "0.67.7",
    "oxfmt": "^0.65.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006"
  },
  "packageManager": "pnpm@11.13.1"
}
