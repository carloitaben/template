{
  "lsp": {
    "typescript-language-server": {
      "binary": {
        "path": "./node_modules/.bin/effect-tsgo",
        "arguments": ["tsc@7.0.2", "--lsp", "--stdio"]
      }
    }
  },
  "languages": {
    "JavaScript": {
      "language_servers": ["typescript-language-server", "oxfmt"],
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    "TypeScript": {
      "language_servers": ["typescript-language-server", "oxfmt"],
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    "TSX": {
      "language_servers": ["typescript-language-server", "oxfmt"],
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    "JSON": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    "JSONC": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    "Markdown": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": { "language_server": { "name": "oxfmt" } }
    },
    "YAML": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": { "language_server": { "name": "oxfmt" } }
    }
  }
}
