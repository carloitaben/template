{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "rules": {
    "effecttsgo/any-unknown-in-error-context": "warn",
    "effecttsgo/unsafe-effect-type-assertion": "warn",
    "effecttsgo/global-json-in-effect": "warn",
    "effecttsgo/global-console-in-effect": "warn",
    "effecttsgo/global-date-in-effect": "warn",
    "effecttsgo/global-fetch-in-effect": "warn",
    "effecttsgo/global-random-in-effect": "warn",
    "effecttsgo/global-timers-in-effect": "warn",
    "effecttsgo/process-env-in-effect": "warn",
    "effecttsgo/map-map-error-to-map-both": "warn",
    "effecttsgo/provide-merge-all-to-array": "warn",
    "effecttsgo/type-union-to-schema-union": "warn",
    "effecttsgo/yield-in-call-argument": "warn",
    "effecttsgo/prefer-barrel-import": "off",
    "effecttsgo/prefer-namespace-import": "warn",
    "effecttsgo/unstable-api-usage": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "effect",
            "importNames": ["*"],
            "message": "Import from an Effect subpath, such as effect/Effect or effect/Schema."
          }
        ]
      }
    ]
  }
}
