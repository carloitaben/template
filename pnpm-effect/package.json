{
  "name": "pnpm-effect",
  "version": "0.0.0",
  "homepage": "https://github.com/OWNER/REPO#readme",
  "bugs": "https://github.com/OWNER/REPO/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/REPO.git"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "test": "vitest run",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@effect/tsgo": "0.67.7",
    "@effect/vitest": "4.1.3",
    "effect": "4.1.3",
    "oxfmt": "^0.65.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "tsdown": "^0.22.14",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "packageManager": "pnpm@11.13.1"
}
